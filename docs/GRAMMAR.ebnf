/* Dippin Language Grammar — W3C EBNF Notation                 */
/* This is the canonical syntax specification for .dip files.   */
/* Notation: W3C EBNF (the XML-spec / bottlecaps dialect) —      */
/*   `::=`, space concatenation, `?` `*` `+`, `[char classes]`,  */
/*   `-` exception, `#xHH` char codes, block comments.          */
/* Reference implementation: parser/lexer.go, parser/parser.go.  */
/*                                                               */
/* Significant-whitespace caveat: INDENT, OUTDENT, NEWLINE and   */
/* the raw multiline blocks (RAW_INLINE, RAW_CONTENT) are tokens */
/* produced by the indentation-aware lexer. They are NOT         */
/* expressible in a context-free grammar, so they appear here as */
/* terminal symbols (no production) — see the Lexical section.   */
/*                                                               */
/* Implementation notes:                                         */
/* - BOOLEAN, INTEGER, FLOAT and DURATION are not distinct token */
/*   types in the lexer; all are lexed as IDENTIFIER tokens and  */
/*   parsed by the consumer (strconv / time.ParseDuration).      */
/* - Conditions are stored as raw text (Condition.Raw); the AST  */
/*   is populated later by EnsureConditionsParsed.               */
/* - Keywords are contextual, not reserved (usable as node IDs), */
/*   except "else" at the start of an edges-block line.          */

/* ============================================================ */
/* Top-Level Structure                                          */
/* ============================================================ */

workflow_file ::= version_decl? workflow_decl

/* Optional leading format-version declaration. Absent => v1.   */
version_decl ::= "dip" INTEGER NEWLINE

workflow_decl ::= "workflow" IDENTIFIER NEWLINE INDENT workflow_body OUTDENT

workflow_body ::= ( workflow_field | defaults_section | vars_section
                  | node_decl | edges_section | stylesheet_section | NEWLINE )*

workflow_field ::= "goal" ":" field_value
                 | "start" ":" IDENTIFIER
                 | "exit" ":" IDENTIFIER
                 | "requires" ":" identifier_list

/* ============================================================ */
/* Defaults Section                                             */
/* ============================================================ */

defaults_section ::= "defaults" NEWLINE INDENT defaults_field* OUTDENT

defaults_field ::= "model" ":" field_value
                 | "provider" ":" field_value
                 | "retry_policy" ":" field_value
                 | "max_retries" ":" INTEGER
                 | "fidelity" ":" field_value
                 | "max_restarts" ":" INTEGER
                 | "restart_target" ":" IDENTIFIER
                 | "on_failure" ":" IDENTIFIER       /* default failure route node */
                 | "cache_tools" ":" BOOLEAN
                 | "compaction" ":" field_value
                 | "on_resume" ":" field_value
                 | "max_total_tokens" ":" INTEGER    /* hard token budget ceiling */
                 | "max_cost_cents" ":" INTEGER      /* hard cost ceiling in USD cents */
                 | "max_wall_time" ":" DURATION      /* hard wall-clock ceiling */
                 | "stall_timeout" ":" DURATION      /* abort/route after no-progress span; 0 = disabled */
                 | "tool_commands_allow" ":" field_value  /* comma-separated glob allowlist */
                 | "tool_denylist_add" ":" field_value    /* comma-separated globs appended to denylist */
                 | "prompt_prefix" ":" field_value        /* cascade: inline prefix prepended to every agent prompt (#175) */
                 | "prompt_suffix" ":" field_value        /* cascade: inline suffix appended to every agent prompt (#175) */
                 | "prompt_prefix_file" ":" field_value   /* cascade: prefix fragment file; mutually exclusive with prompt_prefix */
                 | "prompt_suffix_file" ":" field_value   /* cascade: suffix fragment file; mutually exclusive with prompt_suffix */

/* ============================================================ */
/* Vars Section                                                 */
/* ============================================================ */

vars_section ::= "vars" NEWLINE INDENT vars_field* OUTDENT

vars_field ::= IDENTIFIER ":" field_value

/* ============================================================ */
/* Node Declarations                                            */
/* ============================================================ */

node_decl ::= agent_node | human_node | tool_node
            | subgraph_node | conditional_node
            | parallel_node | fan_in_node | manager_loop_node

agent_node ::= "agent" IDENTIFIER NEWLINE INDENT ( agent_field | common_field )* OUTDENT

agent_field ::= "prompt" ":" field_value
              | "prompt_file" ":" field_value         /* path relative to .dip dir; mutually exclusive with prompt */
              | "system_prompt" ":" field_value
              | "system_prompt_file" ":" field_value  /* path relative to .dip dir; mutually exclusive with system_prompt */
              | "prompt_include" ":" field_value      /* fragment file appended after the body, before the cascade suffix (#175) */
              | "prompt_prefix" ":" "none"            /* opt out of the defaults prompt_prefix cascade (#175) */
              | "prompt_suffix" ":" "none"            /* opt out of the defaults prompt_suffix cascade (#175) */
              | "model" ":" field_value
              | "provider" ":" field_value
              | "backend" ":" field_value
              | "working_dir" ":" field_value
              | "tool_access" ":" field_value
              | "writable_paths" ":" field_value      /* comma-separated path globs; non-empty required */
              | "max_turns" ":" INTEGER
              | "cmd_timeout" ":" DURATION
              | "goal_gate" ":" BOOLEAN
              | "auto_status" ":" BOOLEAN
              | "reasoning_effort" ":" field_value
              | "fidelity" ":" field_value
              | "cache_tools" ":" BOOLEAN
              | "compaction" ":" field_value
              | "compaction_threshold" ":" FLOAT
              | "response_format" ":" field_value     /* "json_object" | "json_schema" */
              | "response_schema" ":" field_value     /* multiline JSON Schema block */
              | "params" ":" params_block             /* pass-through key-value map */

human_node ::= "human" IDENTIFIER NEWLINE INDENT ( human_field | common_field )* OUTDENT

human_field ::= "mode" ":" field_value               /* "freeform" | "choice" | "interview" | "yes_no" */
              | "default" ":" field_value
              | "prompt" ":" field_value              /* instructions shown to the human */
              | "questions_key" ":" IDENTIFIER        /* context key read for questions (interview mode) */
              | "answers_key" ":" IDENTIFIER          /* context key written with answers (interview mode) */
              | "timeout" ":" DURATION                /* per-gate timeout; 0 = none */
              | "timeout_action" ":" field_value      /* "fail" | "default" */

tool_node ::= "tool" IDENTIFIER NEWLINE INDENT ( tool_field | common_field )* OUTDENT

tool_field ::= "command" ":" field_value
             | "command_file" ":" field_value
             | "outputs" ":" identifier_list
             | "marker_grep" ":" field_value          /* regex matched line-by-line against stdout */
             | "route_required" ":" BOOLEAN           /* fail node if no routing signal emitted */
             | "output_limit" ":" INTEGER             /* byte cap on stdout; >0 overrides engine default */
             | "timeout" ":" DURATION

subgraph_node ::= "subgraph" IDENTIFIER NEWLINE INDENT ( subgraph_field | common_field )* OUTDENT

subgraph_field ::= "ref" ":" field_value
                 | "params" ":" params_block

params_block ::= NEWLINE INDENT ( IDENTIFIER ":" field_value )* OUTDENT

conditional_node ::= "conditional" IDENTIFIER NEWLINE INDENT common_field* OUTDENT

/* manager_loop supervises a child subgraph with polling and optional       */
/* mid-run context injection. Maps to DOT shape=house.                      */
manager_loop_node ::= "manager_loop" IDENTIFIER NEWLINE INDENT ( manager_loop_field | common_field )* OUTDENT

manager_loop_field ::= "subgraph_ref" ":" field_value
                     | "poll_interval" ":" DURATION
                     | "max_cycles" ":" INTEGER
                     | "stop_condition" ":" field_value   /* condition expression, stored raw */
                     | "steer_condition" ":" field_value  /* condition expression, stored raw */
                     | "steer_context" ":" steer_context_value

/* steer_context accepts inline "k=v, k=v" CSV or a block of "k: v" lines.   */
steer_context_value ::= field_value | params_block

parallel_node ::= parallel_inline | parallel_block

parallel_inline ::= "parallel" IDENTIFIER "->" identifier_list NEWLINE

parallel_block ::= "parallel" IDENTIFIER NEWLINE INDENT branch_decl* OUTDENT

branch_decl ::= "branch" ":" IDENTIFIER NEWLINE ( INDENT branch_field* OUTDENT )?

branch_field ::= "model" ":" field_value
               | "provider" ":" field_value
               | "fidelity" ":" field_value
               | "tool_access" ":" field_value          /* "" = inherit agent's; "none" = strip tools */
               | "writable_paths" ":" field_value        /* per-branch override of path globs */

fan_in_node ::= "fan_in" IDENTIFIER "<-" identifier_list NEWLINE

identifier_list ::= IDENTIFIER ( "," IDENTIFIER )*

common_field ::= "label" ":" field_value
               | "class" ":" identifier_list
               | "reads" ":" identifier_list
               | "writes" ":" identifier_list
               | "retry_policy" ":" field_value
               | "max_retries" ":" INTEGER
               | "base_delay" ":" DURATION
               | "retry_target" ":" IDENTIFIER
               | "fallback_target" ":" IDENTIFIER

/* ============================================================ */
/* Edges Section                                                */
/* ============================================================ */

/* At most one else_default per block, position-flexible (the formatter      */
/* emits it last). A second else is diagnosed, not silently accepted.        */
edges_section ::= "edges" NEWLINE INDENT edge_entry* ( else_default edge_entry* )? OUTDENT

edge_entry ::= edge_source "->" IDENTIFIER edge_attr* NEWLINE

/* An ordinary edge source is any identifier EXCEPT "else" (W3C "-" =         */
/* exception): a line beginning with "else" is the section default, so a      */
/* node may not be used as an edge source under the ID "else". The target     */
/* position and all other identifier positions are unrestricted.             */
edge_source ::= IDENTIFIER - "else"

/* Section-level error-funnel default: the destination for any node whose     */
/* guards all fail to match and which has no explicit unconditional edge.     */
/* Success-side only — a genuine node failure routes via on_failure, never    */
/* through else. At most one per edges block; the target is required.         */
else_default ::= "else" "->" IDENTIFIER NEWLINE

edge_attr ::= "when" condition
            | "on" OUTCOME_TOKEN     /* sugar: equality vs the source node's outcome channel */
            | "label" ":" field_value
            | "choice" ":" field_value    /* carried human-gate route key */
            | "weight" ":" INTEGER
            | "loop"                  /* back-edge; canonical form */
            | "restart" ":" BOOLEAN   /* legacy alias; fmt -> loop */
            | "override" ":" BOOLEAN  /* carried human-override mark */

/* ============================================================ */
/* Stylesheet Section                                           */
/* ============================================================ */

stylesheet_section ::= "stylesheet" ":" NEWLINE INDENT raw_stylesheet OUTDENT

raw_stylesheet ::= stylesheet_rule*

stylesheet_rule ::= selector NEWLINE INDENT ( IDENTIFIER ":" field_value )* OUTDENT

selector ::= "*"                  /* universal */
           | IDENTIFIER           /* kind: agent, tool, etc */
           | "." IDENTIFIER       /* class */
           | "#" IDENTIFIER       /* node ID */

/* ============================================================ */
/* Condition Expressions                                        */
/* ============================================================ */

condition ::= or_expr

or_expr ::= and_expr ( "or" and_expr )*

and_expr ::= unary_expr ( "and" unary_expr )*

unary_expr ::= "not" unary_expr | compare_expr

/* Infix negation: "ctx.outcome not contains val" is equivalent to            */
/* "not (ctx.outcome contains val)".                                          */
compare_expr ::= operand "not"? compare_op operand

/* All operators perform string comparison — no numeric coercion.            */
compare_op ::= "==" | "!=" | "="
             | "contains" | "startswith" | "endswith" | "in"

operand ::= variable | STRING | IDENTIFIER

/* Variables use dotted namespaces, e.g. ctx.outcome, graph.goal.             */
variable ::= IDENTIFIER "." IDENTIFIER

/* ============================================================ */
/* Field Values                                                 */
/* ============================================================ */

field_value ::= inline_value | multiline_block

inline_value ::= STRING | RAW_INLINE

multiline_block ::= NEWLINE INDENT RAW_CONTENT OUTDENT

/* ============================================================ */
/* Lexical Elements                                             */
/* ============================================================ */

IDENTIFIER ::= [A-Za-z0-9] [A-Za-z0-9_./-]*

/* The `on` shorthand value is stricter than IDENTIFIER: no "." or "/".       */
OUTCOME_TOKEN ::= [A-Za-z0-9] [A-Za-z0-9_-]*

STRING ::= '"' dq_char* '"'
         | "'" sq_char* "'"

dq_char ::= Char - ( '"' | '\' )
          | '\' ( '"' | '\' )

/* Single-quoted strings are literal (no backslash escapes); a doubled ''     */
/* produces a single ' (YAML-style).                                          */
sq_char ::= Char - "'"
          | "'" "'"

INTEGER ::= [0-9]+

FLOAT ::= [0-9]+ "." [0-9]+

BOOLEAN ::= "true" | "false"

COMMENT ::= "#" ( Char - #xA )*

Char ::= [#x9#xA#xD#x20-#x10FFFF]

/* Lexer-produced tokens with no context-free production (significant         */
/* whitespace / raw capture): they are terminals supplied by the lexer.       */
/*   NEWLINE     — end of a logical line.                                      */
/*   INDENT      — increase in leading whitespace from the previous line.      */
/*   OUTDENT     — decrease in leading whitespace to a previous indent level.  */
/*   DURATION    — Go time.ParseDuration form, e.g. "30s", "5m", "1h30m".      */
/*   RAW_INLINE  — all characters from ':' to end of line (trimmed).           */
/*   RAW_CONTENT — verbatim block text at the field's indentation, captured    */
/*                 with no tokenization (shell, markdown, JSON, code, ...).    */

/* ============================================================ */
/* Whitespace and Comments                                      */
/* ============================================================ */

/* - Indentation is significant (like Python/YAML); 2-space indent.           */
/* - Tabs count as one byte of indentation.                                   */
/* - Blank lines and comment-only (# ...) lines are ignored for indentation.  */
/* - Inline comments require preceding whitespace.                            */
/* - Comments inside multiline blocks are literal content.                    */

/* ============================================================ */
/* Keywords (contextual, not reserved)                          */
/* ============================================================ */

/* These identifiers have special meaning in context but can be used as node  */
/* IDs without conflict: workflow, agent, human, tool, subgraph, conditional,  */
/* parallel, fan_in, manager_loop, edges, defaults, vars, when, on, and, or,   */
/* not, contains, startswith, endswith, in, true, false, restart, loop,        */
/* override, label, choice, weight. The sole exception is "else", which is     */
/* reserved as the first token of an edges-block line (the section default).   */
