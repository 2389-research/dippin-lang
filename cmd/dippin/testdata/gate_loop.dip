workflow PlanLoop
  goal: "Gate-driven revise loop"
  start: Plan
  exit: Done

  agent Plan
    prompt:
      Plan.

  human PlanReview
    label: "Approve the plan?"
    mode: choice
    default: "hold"

  agent Hold
    prompt:
      Hold.

  agent Done
    prompt:
      Done.

  edges
    Plan -> PlanReview
    PlanReview -> Done  label: "approve"
    PlanReview -> Hold  label: "hold"
    PlanReview -> Plan  label: "revise"  loop
    Hold -> Done
