workflow ExternalPrompts
  goal: "Demonstrate prompt_file:/system_prompt_file: directives (issue #65)"
  start: Reviewer
  exit: Reviewer

  agent Reviewer
    model: claude-sonnet-4-6
    system_prompt_file: external_prompts/reviewer-persona.md
